steps li {background: var(--ink-card);border-radius: 22px;padding: 26px 24px 28px;box-shadow: 0 22px 50px -32px rgba(0,0,0,.95), 0 0 0 1px var(--line)}\n  .step-no {font-size: 12px;letter-spacing: .18em;color: var(--neon);display: block;margin-bottom: 14px}\n  .steps h3 {font-size: 18px;margin: 0 0 10px;font-weight: 700}\n  .steps p {margin: 0;font-size: 14px;color: var(--muted)}\n\n  /* ---------- 客户端 ---------- */\n  .clients {display: grid;grid-template-columns: repeat(2, minmax(0, 1fr));gap: 22px}\n  .client {background: var(--ink-card);border-radius: 22px;padding: 26px 26px 24px;box-shadow: 0 22px 50px -32px rgba(0,0,0,.95), 0 0 0 1px var(--line);display: grid;grid-template-columns: 1fr auto;gap: 6px 18px;align-items: baseline}\n  .client h3 {font-size: 17px;margin: 0;font-weight: 700}\n  .client .scale {font-size: 12px;color: var(--neon);letter-spacing: .1em;white-space: nowrap}\n  .client p {grid-column: 1 / -1;margin: 4px 0 0;font-size: 14px;color: var(--muted)}\n\n  /* ---------- FAQ 双栏问答 ---------- */\n  .faq-grid {display: grid;grid-template-columns: repeat(2, minmax(0, 1fr));gap: 20px 24px}\n  .qa {background: var(--ink-card);border-radius: 22px;padding: 24px 24px 20px;box-shadow: 0 22px 50px -32px rgba(0,0,0,.95), 0 0 0 1px var(--line)}\n  .qa h3 {font-size: 16px;margin: 0 0 10px;font-weight: 700;color: var(--paper)}\n  .qa h3::before {content: \"Q\";color: var(--neon);font-weight: 800;margin-right: 9px;letter-spacing: .06em}\n  .qa p {margin: 0;font-size: 14px;color: var(--muted)}\n\n  /* ---------- 收尾 ---------- */\n  .closing {border-top: 1px solid var(--line);padding: 58px 0 70px;display: grid;grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);gap: 40px;align-items: center}\n  .closing h2 {font-size: clamp(24px, 3vw, 34px);margin: 0;font-weight: 800}\n  .closing p {margin: 0;color: var(--muted);font-size: 14px}\n  .closing a.cta {display: inline-block;margin-top: 16px;color: var(--ink);background: var(--neon);text-decoration: none;font-weight: 700;font-size: 14px;padding: 12px 24px;border-radius: 999px}\n  .closing a.cta:hover {background: var(--neon-dim)}\n\n  footer {border-top: 1px solid var(--line);padding: 26px 0 40px;font-size: 12px;color: var(--muted);display: flex;flex-wrap: wrap;justify-content: space-between;gap: 10px}\n\n  @media (max-width: 940px) {\n    .hero {grid-template-columns: 1fr;gap: 36px;padding-bottom: 56px}\n    .section-head {grid-template-columns: 1fr;gap: 14px}\n    .steps {grid-template-columns: 1fr}\n    .clients {grid-template-columns: 1fr}\n    .faq-grid {grid-template-columns: 1fr}\n    .closing {grid-template-columns: 1fr;gap: 20px}\n  }\n  @media (max-width: 560px) {\n    .wrap {padding: 0 16px}\n    section {padding: 46px 0}\n    .panel {padding: 24px 20px;border-radius: 20px}\n    .topbar-inner {flex-wrap: wrap}\n    .topbar-note {text-align: left}\n    h1 {font-size: 38px}\n    .steps li, .qa, .client {border-radius: 18px}\n  }\n</style><div class=\"topbar\">\n  <div class=\"wrap topbar-inner\">\n    <div class=\"wordmark\">HEY<span>PIG</span></div>\n    <div class=\"topbar-note\">订阅方案 · 设备额度 · 使用说明</div>\n  </div>\n</div>\n\n<main>\n  <div class=\"wrap\">\n\n    <nav class=\"anchors\" aria-label=\"页面目录\">\n      <a href=\"#hero\">概览</a>\n      <a href=\"#plans\">订阅方案</a>\n      <a href=\"#howto\">怎么用</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n      <a href=\"#contact\">下一步</a>\n    </nav>\n\n    <section class=\"hero\" id=\"hero\">\n      <div>\n        <span class=\"eyebrow\">HEYPIG / 订阅说明</span>\n        <h1 id=\"hero-title\">HEYPIG · 先把额度写清楚，<br>再谈<em>用起来</em>。</h1>\n        <p class=\"lede\">HEYPIG 的三档订阅，按月付还是按年付，价格都摆在台面上。流量多少、能同时登几台设备、走什么线路，一行行列在表格里，不用来回切换页面拼信息。</p>\n        <ul class=\"hero-points\">\n          <li><strong>三档可选</strong>基础版、旗舰版、团队版，覆盖个人到小团队的不同额度。</li>\n          <li><strong>横向对比</strong>同一张表里比对流量、设备数与线路项，差异直接可见。</li>\n          <li><strong>年付更省</strong>三档均提供年付价格，是否划算按使用周期自己算。</li>\n        </ul>\n      </div>\n\n      <aside class=\"panel\">\n        <h2 id=\"panel-title\">关键数字</h2>\n        <dl>\n          <div>\n            <dt>起步价格</dt>\n            <dd>¥15<small>/ 月起</small></dd>\n          </div>\n          <div>\n            <dt>推荐档位</dt>\n            <dd>旗舰版 ¥35<small>/ 月</small></dd>\n          </div>\n          <div>\n            <dt>最高设备数</dt>\n            <dd>20<small>台 / 团队版</small></dd>\n          </div>\n          <div>\n            <dt>最高月流量</dt>\n            <dd>1000<small>GB / 团队版</small></dd>\n          </div>\n        </dl>\n        <div class=\"panel-foot\">\n          价格与权益以页面表格为准，年付方案按整年一次性计。\n          <a href=\"#plans\">看完整对比</a>\n        </div>\n      </aside>\n    </section>\n\n    <section id=\"plans\">\n      <div class=\"section-head\">\n        <h2 id=\"plans-title\">订阅方案<span>。</span></h2>\n        <p>三档一次排开。左侧是比对项，右侧是每一档的具体数字与权益。带荧光绿标记的是我们更常被问到的那一档。</p>\n      </div>\n\n      <div class=\"table-scroll\">\n        <table>\n          HEYPIG 订阅方案横向对比 · 价格按月计，年付为整年一次性价格\n          <thead>\n            <tr>\n              <th>比对项</th>\n              <th>\n                <span class=\"plan-name\">基础版</span>\n                <span class=\"plan-price\">¥15<small>/ 月</small></span>\n                <span class=\"plan-annual\">年付 ¥150 / 年</span>\n              </th>\n              <th class=\"is-featured\">\n                <span class=\"flag\">常见选择</span>\n                <span class=\"plan-name\">旗舰版</span>\n                <span class=\"plan-price\">¥35<small>/ 月</small></span>\n                <span class=\"plan-annual\">年付 ¥350 / 年</span>\n              </th>\n              <th>\n                <span class=\"plan-name\">团队版</span>\n                <span class=\"plan-price\">¥85<small>/ 月</small></span>\n                <span class=\"plan-annual\">年付 ¥850 / 年</span>\n              </th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>每月流量额度</th>\n              <td>100GB</td>\n              <td class=\"is-featured\">300GB</td>\n              <td>1000GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td class=\"is-featured\">5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>流媒体支持</th>\n              <td>基础流媒体</td>\n              <td class=\"is-featured\">全节点原生流媒体支持</td>\n              <td>全节点原生流媒体支持</td>\n            </tr>\n            <tr>\n              <th>线路类型</th>\n              <td>普通线路节点池</td>\n              <td class=\"is-featured\">含 IPLC 专线游戏线路优化</td>\n              <td>VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>路由与定制</th>\n              <td>标准路由</td>\n              <td class=\"is-featured\">标准路由</td>\n              <td>支持企业定制路由</td>\n            </tr>\n            <tr>\n              <th>支持方式</th>\n              <td>工单支持</td>\n              <td class=\"is-featured\">工单优先响应</td>\n              <td>专属客户经理对接</td>\n            </tr>\n            <tr>\n              <th>年付价格</th>\n              <td>¥150 / 年</td>\n              <td class=\"is-featured\">¥350 / 年</td>\n              <td>¥850 / 年</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <div class=\"table-foot\">\n        <span>年付价等于 10 个月月付，是否合适取决于你打算用多久。流量按自然月重置。</span>\n        <a href=\"#contact\">看下一步怎么走</a>\n      </div>\n    </section>\n\n    <section id=\"howto\">\n      <div class=\"section-head\">\n        <h2 id=\"howto-title\">怎么开始用<span>。</span></h2>\n        <p>三步，不需要先学一套术语。选档、确认额度、装客户端，顺序就这么简单。</p>\n      </div>\n      <ol class=\"steps\">\n        <li>\n          <span class=\"step-no\">第一步</span>\n          <h3>对着表格选一档</h3>\n          <p>先看同时在线设备数，再看月流量。设备多过 5 台就直接看团队版，别在中间档反复横跳。</p>\n        </li>\n        <li>\n          <span class=\"step-no\">第二步</span>\n          <h3>确认计费周期</h3>\n          <p>月付机动，年付便宜两个月。如果你是短期用，选月付更省心；打算长期跑，年付一次结清。</p>\n        </li>\n        <li>\n          <span class=\"step-no\">第三步</span>\n          <h3>在设备上装好客户端</h3>\n          <p>按系统选对应客户端，装上后填入订阅信息即可。具体入口见下方客户端区块。</p>\n        </li>\n      </ol>\n    </section>\n\n    <section id=\"clients\">\n      <div class=\"section-head\">\n        <h2 id=\"clients-title\">客户端<span>。</span></h2>\n        <p>HEYPIG 不自建客户端。你在自己的系统上用常见的客户端软件接入，订阅信息在客户端里填写。</p>\n      </div>\n      <div class=\"clients\">\n        <article class=\"client\">\n          <h3>桌面端</h3>\n          <span class=\"scale\">按系统选择</span>\n          <p>Windows 与 macOS 各有对应的常用客户端，安装后按软件提示填写订阅信息。具体下载请以客户端官方渠道为准，本站不提供安装包。</p>\n        </article>\n        <article class=\"client\">\n          <h3>移动端</h3>\n          <span class=\"scale\">iOS / Android</span>\n          <p>手机和平板上可使用对应系统的客户端应用，安装与更新通过各自的应用商店完成。版本差异以商店页面说明为准。</p>\n        </article>\n        <article class=\"client\">\n          <h3>路由器与多设备</h3>\n          <span class=\"scale\">看设备额度</span>\n          <p>如果你希望一台路由器下所有设备共用，请先核对套餐的同时在线设备数上限，超出额度的连接不在套餐范围内。</p>\n        </article>\n        <article class=\"client\">\n          <h3>订阅信息填写</h3>\n          <span class=\"scale\">一处配置</span>\n          <p>把订阅信息填入客户端即可生效，不需要逐台重复注册。更换设备时，注意先断开旧设备的连接再接入新设备。</p>\n        </article>\n      </div>\n    </section>\n\n    <section id=\"faq\">\n      <div class=\"section-head\">\n        <h2 id=\"faq-title\">常见问题<span>。</span></h2>\n        <p>问得最多的几件事，一句一句答。没覆盖到的，可以按下方方式联系我们。</p>\n      </div>\n\n      <div class=\"faq-grid\">\n        <article class=\"qa\">\n          <h3>流量是按月重置吗？用不完会累积吗？</h3>\n          <p>套餐里的月流量是每月额度，按自然月计算。当月没用完的部分不结转到下个月，也不会折算成折扣。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>三档套餐的差别主要在哪？</h3>\n          <p>三件事：月流量、同时在线设备数、线路类型。基础版是普通线路节点池；旗舰版在流媒体和游戏线路上做了优化；团队版给到 VIP 专属高带宽节点与定制路由。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>设备数怎么算？一台手机加一台电脑算两台吗？</h3>\n          <p>算两台。同时在线设备数是按当前处于连接状态的设备计数的，断开一台后再接入另一台，不会额外占用额度。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>年付和月付差在哪里？</h3>\n          <p>只是计费周期不同。年付一次付清整年，价格相当于十个月的月付；月付按月续费，更灵活，但整年算下来总支出更高。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>可以把账号分享给朋友一起用吗？</h3>\n          <p>套餐按同时在线设备数计。多人共用一个账号会挤占设备额度，也容易让连接数超出上限，建议按实际使用人数选择对应档位。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>需要自己下载安装包吗？</h3>\n          <p>HEYPIG 不提供客户端安装包。请通过你所使用客户端的官方渠道获取，安装完成后按软件提示填写订阅信息即可。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>团队版里的定制路由指什么？</h3>\n          <p>指可以按团队的实际使用场景与对接人员沟通路由安排，具体能做到哪一步，以沟通结果为准，不在页面上一概承诺。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>遇到问题找谁？</h3>\n          <p>基础版走工单；旗舰版工单优先响应；团队版有专属客户经理对接。请优先通过你订阅时使用的渠道联系我们。</p>\n        </article>\n      </div>\n    </section>\n\n    <section id=\"contact\" class=\"closing\">\n      <div>\n        <h2 id=\"contact-title\">选好了，就往下走一步。</h2>\n        <p>把档位和计费周期定下来，再去装客户端。两件事都清楚，剩下的就是日常使用。</p>\n      </div>\n      <div>\n        <p>价格、权益与支持方式以本页表格与说明为准。有额外需求，先沟通再决定。</p>\n        <a class=\"cta\" href=\"#plans\">回到方案对比</a>\n      </div>\n    </section>\n\n  </div>\n</main>\n\n<div class=\"wrap\">\n  <footer>\n    <span>HEYPIG · 订阅方案与使用说明</span>\n    <span>本页价格与权益以所列为准，未列明的事项不作承诺。</span>\n  </footer>\n</div>",
